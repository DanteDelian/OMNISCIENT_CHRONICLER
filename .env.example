# ---- Omniscient Chronicler v3 ----
# Kopiere diese Datei zu ".env" und passe sie an.

# Optionaler PIN-Schutz, wenn die App im WLAN laeuft (leer = kein Schutz)
APP_PIN=

# Server-Port und Host (0.0.0.0 = von Tablet/Handy im WLAN erreichbar)
PORT=3000
HOST=0.0.0.0

# Optional: abweichende Speicherorte (Standard: ./vault und ./data)
# VAULT_DIR=
# DATA_DIR=

# ---- KI-Sidecar ----
# Standard-Provider; einzeln ueberschreibbar (PARSE_/TRANSCRIBE_)
AI_PROVIDER=ollama            # ollama | gemini
# PARSE_PROVIDER=ollama       # ollama | gemini
# TRANSCRIBE_PROVIDER=gemini  # gemini | whisper

# Ollama (lokal, kostenlos) – Parsing
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2

# Gemini (Cloud) – Transkription und/oder Parsing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Lokale Transkription (optional, faster-whisper)
WHISPER_MODEL=base

# Adresse des Sidecars (von der App aus)
SIDECAR_URL=http://127.0.0.1:8756
SIDECAR_PORT=8756
