# Kopiere diese Datei zu ".env" (im Hauptordner) und passe sie an. Alles ist optional.

# PIN-Schutz, wenn die App im WLAN laeuft (leer = kein Schutz)
APP_PIN=

# Port und Host des Servers (0.0.0.0 = auch von Tablet/Handy im WLAN erreichbar)
PORT=3000
HOST=0.0.0.0

# Anderer Speicherort der Kampagnendaten (Standard: ./campaign)
# CAMPAIGN_DIR=
