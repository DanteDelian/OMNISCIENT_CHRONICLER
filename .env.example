# ---- Omniscient Chronicler v4 ----
# Kopiere diese Datei zu ".env" und passe sie an (optional).

# Optionaler PIN-Schutz, wenn die App im WLAN laeuft (leer = kein Schutz)
APP_PIN=

# Server-Port und Host (0.0.0.0 = von Tablet/Handy im WLAN erreichbar)
PORT=3000
HOST=0.0.0.0

# Optional: abweichender Speicherort der Kampagnendaten (Standard: ./campaign)
# CAMPAIGN_DIR=

# ---- Optionale KI (Session-Werkstatt: RAW -> Vorschlaege) ----
# Ohne Schluessel funktioniert die App voll; die Werkstatt bietet dann nur den
# manuellen/Claude-Code-Weg. Mit Schluessel schlaegt die KI Aenderungen vor,
# die du einzeln pruefst (accept/edit/reject) — geschrieben wird nichts ohne dich.
# AI_PROVIDER=gemini            # gemini | mock | none  (leer = auto: gemini wenn Key gesetzt)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
#
# Hinweis Entwicklung: `npm run dev` liest .env aus dem app/-Ordner; lege den
# Schluessel dort ab (app/.env) oder setze ihn als Umgebungsvariable.
